# Optional. Defaults to ARRIFY_ORIGIN. Public remote joining requires HTTPS.
# LAN-only HTTP on private IP/local hostnames remains supported.
ARRIFY_PARTY_PUBLIC_ORIGIN=https://music.example.com
# Use real signed iOS app IDs only after a native app exists; empty disables AASA entries.
ARRIFY_IOS_APP_IDS=
# Preserve existing ARRIFY_ALLOWED_ORIGINS and add any new public origin explicitly.
# Back up ARRIFY_DATA/party-invitations.key privately alongside accounts.db.
