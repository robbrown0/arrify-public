# Server/operator configuration only. Never put these values in a user profile.
ARRIFY_APPLE_TEAM_ID=ABCDEFGHIJ
ARRIFY_APPLE_KEY_ID=KLMNOPQRST
ARRIFY_APPLE_KEY_PATH=/srv/arrify-example/arrify/secrets/musickit.p8
# Create the secrets directory with mode 0700 and key mode 0400, owned by 21012.
# The MusicKit Media ID must have MusicKit enabled for this website's app.
# Host Apple Music authorization stays device-specific; no Apple password is stored.
