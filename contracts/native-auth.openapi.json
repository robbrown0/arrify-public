{
  "openapi": "3.0.3",
  "info": {
    "title": "Arrify Native Session Foundation",
    "version": "1.0.0",
    "description": "First-party session API, not OAuth. Additive contract; legacy catalog/media APIs are not yet covered. Times are Unix seconds; durations are seconds. Clients ignore unknown response fields and feature strings. All responses are no-store. TLS required outside loopback tests."
  },
