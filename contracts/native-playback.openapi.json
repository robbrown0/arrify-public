{
  "openapi": "3.0.3",
  "info": {
    "title": "Arrify Native Playback Foundation",
    "version": "1.0.0",
    "description": "Bearer-authenticated control and catalog API; scoped media URLs require no bearer header. Catalog revision is a paging snapshot, not media identity. Durations and timestamps are seconds. Ignore unknown optional fields and handle unknown enum strings. Album/artist IDs currently change with metadata names; do not persist them as durable references."
  },
  "paths": {
    "/api/v1/native/playback/manifest": {
      "post": {
        "operationId": "prepareNativeManifest",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Manifest"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ManifestRequest"
              }
            }
          }
        }
      }
    },
    "/api/v1/native/playback": {
      "get": {
        "operationId": "getNativePlayback",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Playback"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "operationId": "commandNativePlayback",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Playback"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlaybackCommand"
              }
            }
          }
        }
      }
    },
    "/api/v1/native/catalog": {
      "get": {
        "operationId": "getNativeCatalog",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "tracks",
                "artists",
                "albums"
              ]
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "revision",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/native/library": {
      "get": {
        "summary": "Browse the existing account library",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Library data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryOverview"
                }
              }
            }
          },
          "401": {
            "description": "Sign in again"
          },
          "409": {
            "description": "Restart pagination after a catalog change"
          }
        }
      }
    },
    "/api/v1/native/library/detail": {
      "get": {
        "summary": "Page songs in a library context",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Library data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryDetail"
                }
              }
            }
          },
          "401": {
            "description": "Sign in again"
          },
          "409": {
            "description": "Restart pagination after a catalog change"
          }
        },
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "revision",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/native/playback/queue": {
      "get": {
        "operationId": "nativeQueue",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Pages queue occurrences by index. Send revision on subsequent pages; stale pages return 409. Edits carry expected_revision.",
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "revision",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Queue page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueuePage"
                }
              }
            }
          },
          "409": {
            "description": "Queue changed"
          }
        }
      }
    },
    "/api/v1/listening/events": {
      "get": {
        "summary": "Account-scoped playback invalidations shared with web clients",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "SSE session events carry a monotonically increasing account event version. Fetch authoritative playback state; events are not commands. Reconnect with a current bearer token after closure.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Invalid or revoked session"
          },
          "429": {
            "description": "Account connection limit; polling remains available"
          },
          "503": {
            "description": "Live connections busy; polling remains available"
          }
        }
      }
    },
    "/api/v1/native/favorites": {
      "get": {
        "summary": "Saved song IDs for the signed-in account",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Favorites"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Sign in again"
          },
          "403": {
            "description": "Account unavailable"
          },
          "429": {
            "description": "Retry shortly"
          }
        }
      },
      "post": {
        "summary": "Set whether a song is saved; shares web favorites",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Favorites"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Sign in again"
          },
          "403": {
            "description": "Account unavailable"
          },
          "429": {
            "description": "Retry shortly"
          },
          "404": {
            "description": "Song no longer available"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FavoriteChange"
              }
            }
          }
        }
      }
    },
    "/api/v1/native/live-activity": {
      "get": {
        "summary": "Push availability; local control eligibility requires an authenticated reachability proof",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveActivityAvailability"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Sign in again"
          },
          "403": {
            "description": "Account unavailable"
          },
          "429": {
            "description": "Retry shortly"
          }
        }
      },
      "post": {
        "summary": "Register, stop, or control the registered playback session on the same local network",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "ok": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "ok"
                      ]
                    },
                    {
                      "$ref": "#/components/schemas/Playback"
                    },
                    {
                      "type": "object",
                      "required": [
                        "controls_available"
                      ],
                      "properties": {
                        "controls_available": {
                          "type": "boolean"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Sign in again"
          },
          "403": {
            "description": "Account unavailable"
          },
          "429": {
            "description": "Retry shortly"
          },
          "409": {
            "description": "Playback moved or token belongs to another session"
          },
          "503": {
            "description": "Push updates not configured"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/LiveActivityRegistration"
                  },
                  {
                    "$ref": "#/components/schemas/LiveActivityStop"
                  },
                  {
                    "$ref": "#/components/schemas/LiveActivityControl"
                  },
                  {
                    "$ref": "#/components/schemas/LocalPresenceVerification"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/api/v1/native/playlists": {
      "post": {
        "summary": "Create a personal playlist or add a song; only its owner can edit",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryEntry"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Sign in again"
          },
          "403": {
            "description": "Account unavailable"
          },
          "429": {
            "description": "Retry shortly"
          },
          "404": {
            "description": "Song no longer available"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlaylistChange"
              }
            }
          }
        }
      }
    },
    "/api/v1/native/local-presence": {
      "post": {
        "summary": "Publish the native playback session local proof key or request a single-use controller challenge",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/LocalPresencePublish"
                  },
                  {
                    "$ref": "#/components/schemas/LocalPresenceChallenge"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Publication acknowledged or opaque service and 12-second nonce returned"
          },
          "400": {
            "description": "Invalid fields"
          },
          "401": {
            "description": "Sign in again"
          },
          "403": {
            "description": "Owner session or local verification unavailable"
          },
          "409": {
            "description": "Playback owner changed"
          },
          "429": {
            "description": "Retry shortly"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "request_id"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "request_id": {
                "type": "string"
              }
            }
          }
        }
      },
      "ManifestRequest": {
        "type": "object",
        "properties": {
          "device_id": {
            "type": "string",
            "pattern": "^[a-f0-9-]{16,64}$"
          },
          "owner_epoch": {
            "type": "integer",
            "minimum": 0
          },
          "profile": {
            "type": "string",
            "enum": [
              "original",
              "aac",
              "mp3"
            ]
          },
          "level": {
            "type": "string",
            "enum": [
              "off"
            ]
          },
          "retry": {
            "type": "boolean"
          }
        },
        "required": [
          "device_id",
          "owner_epoch"
        ]
      },
      "MediaItem": {
        "type": "object",
        "properties": {
          "track_id": {
            "type": "integer",
            "minimum": 0
          },
          "source_revision": {
            "type": "string",
            "nullable": true
          },
          "profile": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "ready",
              "preparing",
              "queued",
              "retrying",
              "failed",
              "unavailable"
            ]
          },
          "duration_seconds": {
            "type": "number",
            "minimum": 0,
            "nullable": true
          },
          "mime_type": {
            "type": "string",
            "nullable": true
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "nullable": true
          },
          "url": {
            "type": "string",
            "nullable": true
          },
          "url_expires": {
            "type": "integer",
            "minimum": 0,
            "nullable": true
          },
          "range_supported": {
            "type": "boolean"
          }
        },
        "required": [
          "track_id",
          "source_revision",
          "profile",
          "state",
          "duration_seconds",
          "mime_type",
          "size_bytes",
          "url",
          "url_expires",
          "range_supported"
        ]
      },
      "Manifest": {
        "type": "object",
        "properties": {
          "device_id": {
            "type": "string"
          },
          "owner_epoch": {
            "type": "integer",
            "minimum": 0
          },
          "queue_revision": {
            "type": "integer",
            "minimum": 0
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MediaItem"
            },
            "maxItems": 4
          },
          "retry_after_seconds": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "device_id",
          "owner_epoch",
          "queue_revision",
          "items",
          "retry_after_seconds"
        ]
      },
      "Track": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "artist": {
            "type": "string"
          },
          "album": {
            "type": "string"
          },
          "availability": {
            "type": "string",
            "enum": [
              "local"
            ]
          },
          "artwork": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "title",
          "artist",
          "album"
        ]
      },
      "Entity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "artist": {
            "type": "string"
          },
          "track_count": {
            "type": "integer",
            "minimum": 0
          },
          "artwork": {
            "type": "string",
            "nullable": true
          },
          "kind": {
            "type": "string"
          },
          "subtitle": {
            "type": "string"
          },
          "section": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "artist",
          "track_count"
        ]
      },
      "CatalogPage": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "next_offset": {
            "type": "integer",
            "minimum": 0,
            "nullable": true
          },
          "items": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/Track"
                },
                {
                  "$ref": "#/components/schemas/Entity"
                }
              ]
            }
          }
        },
        "required": [
          "kind",
          "revision",
          "total",
          "next_offset",
          "items"
        ]
      },
      "Playback": {
        "type": "object",
        "properties": {
          "partial": {
            "type": "boolean"
          },
          "current_track_id": {
            "type": "integer",
            "minimum": 0,
            "nullable": true
          },
          "position_seconds": {
            "type": "number",
            "minimum": 0
          },
          "server_time": {
            "type": "number",
            "minimum": 0
          },
          "queue_revision": {
            "type": "integer",
            "minimum": 0
          },
          "owner_device_id": {
            "type": "string",
            "nullable": true
          },
          "owner_epoch": {
            "type": "integer",
            "minimum": 0
          },
          "intent": {
            "type": "integer",
            "minimum": 0
          },
          "playing": {
            "type": "boolean"
          },
          "observed": {
            "type": "string"
          },
          "seek_target_seconds": {
            "type": "number",
            "minimum": 0
          },
          "seek_intent": {
            "type": "integer",
            "minimum": 0
          },
          "play_id": {
            "type": "integer",
            "minimum": 0
          },
          "upcoming_track_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "maxItems": 3,
            "nullable": true
          },
          "repeat_mode": {
            "type": "string",
            "nullable": true,
            "enum": [
              "off",
              "all",
              "one",
              null
            ]
          },
          "queue_controls_available": {
            "type": "boolean",
            "nullable": true
          },
          "context": {
            "type": "object",
            "nullable": true,
            "properties": {
              "kind": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "id": {
                "type": "string",
                "description": "Stable source identity; optional for older server states."
              }
            },
            "required": [
              "kind",
              "name"
            ]
          },
          "duration_seconds": {
            "type": "number",
            "minimum": 0
          },
          "output": {
            "type": "string"
          },
          "shuffle": {
            "type": "boolean",
            "nullable": true,
            "description": "Whether the remaining queue is shuffled; omitted or null on compact updates."
          }
        },
        "required": [
          "partial",
          "current_track_id",
          "position_seconds",
          "server_time",
